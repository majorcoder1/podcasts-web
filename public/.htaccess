# Shared-hosting config for the podcast app.
#
# The document root for podcast.4thepeople.live should point at this folder.
# Everything here is static except api.php, which is the same-origin proxy the
# front end needs because podcast feeds send no CORS headers.
#
# The host already redirects http -> https, so there is deliberately no HTTPS
# rewrite here: adding one behind a load balancer is how you get a loop.

<IfModule mod_rewrite.c>
    RewriteEngine On

    # /api/<name> -> api.php, which routes on the last path segment.
    RewriteRule ^api/(health|register|login|logout|me|password|sync|feed|search|charts|audio)/?$ api.php [QSA,L]

    # The player is a single-page app mounted at /app, so /app/show/... has to
    # survive a refresh or a shared link.
    RewriteRule ^app(/.*)?$ app.html [L]

    # Anything else that is not a real file falls back to the landing page -
    # except requests that name a file. A missing asset must 404, not return
    # HTML where the browser asked for JSON.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} !^/api/
    RewriteCond %{REQUEST_URI} !\.[a-zA-Z0-9]{2,5}$
    RewriteRule . index.html [L]
</IfModule>

<IfModule mod_mime.c>
    AddType application/manifest+json .webmanifest
    AddType image/svg+xml            .svg
    AddType text/javascript          .js
    AddType application/vnd.android.package-archive .apk
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/javascript \
        application/javascript application/json image/svg+xml application/manifest+json
</IfModule>

# The app ships unversioned module paths, so assets must revalidate or a
# re-upload would not reach anyone still holding a cached copy. Apache's ETags
# turn each revalidation into a cheap 304.
<IfModule mod_headers.c>
    <FilesMatch "\.(html|js|css|webmanifest)$">
        Header set Cache-Control "no-cache"
    </FilesMatch>

    # The APK is immutable once published; a new build gets a new filename.
    <FilesMatch "\.apk$">
        Header set Cache-Control "public, max-age=86400"
        Header set Content-Disposition "attachment"
    </FilesMatch>
    <FilesMatch "^sw\.js$">
        Header set Cache-Control "no-cache"
        Header set Service-Worker-Allowed "/"
    </FilesMatch>
    <FilesMatch "\.(svg|png|jpg|jpeg|webp|ico)$">
        Header set Cache-Control "public, max-age=604800"
    </FilesMatch>

    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "no-referrer"
    Header always set X-Frame-Options "SAMEORIGIN"

    # Browsers only honour this over HTTPS, and the host already forces HTTPS,
    # so it is safe to send on every response. Once a browser has seen it, it
    # will not try plain HTTP for this site for a year.
    Header always set Strict-Transport-Security "max-age=31536000"

    # A podcast player needs none of these; switch them off so nothing loaded
    # into the page can ask for them either.
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), serial=(), bluetooth=(), midi=(), display-capture=(), browsing-topics=()"
</IfModule>

# Artwork and audio come straight from publishers; everything else is ours.
<IfModule mod_headers.c>
    <FilesMatch "\.html$">
        Header set Content-Security-Policy "default-src 'self'; img-src 'self' https: data:; media-src 'self' https: blob:; connect-src 'self' https:; script-src 'self'; style-src 'self'; base-uri 'none'; frame-ancestors 'self'"
    </FilesMatch>
</IfModule>

<IfModule mod_dir.c>
    DirectoryIndex index.html index.php
</IfModule>

# Server-side code and the database are never served as files. The data
# directory also lives above the document root where the host allows it, so a
# host that ignores .htaccess still cannot hand out the database.
RedirectMatch 404 ^/(lib|data)/

# Nothing here should ever be listed.
Options -Indexes
