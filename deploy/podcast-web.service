# systemd unit for the Python server.
#
#   sudo cp deploy/podcast-web.service /etc/systemd/system/
#   sudo systemctl enable --now podcast-web

[Unit]
Description=Podcasts web app
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=www-data
WorkingDirectory=/srv/podcast-web
ExecStart=/usr/bin/python3 /srv/podcast-web/server.py --host 127.0.0.1 --port 8080
Restart=on-failure
RestartSec=3

# It only needs to read its own directory and reach the network.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/srv/podcast-web

[Install]
WantedBy=multi-user.target
